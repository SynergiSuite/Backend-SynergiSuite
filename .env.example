# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-only port for tools such as psql or pgAdmin; containers still use 5432.
POSTGRES_HOST_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=synergisuite
POSTGRES_SSL=false
POSTGRES_CONNECT_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_POOL_MAX=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d

# App
PORT=3000
NODE_ENV=development
SECRET_KEY=your_cron_shared_secret

# Email (configure based on your email provider)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@synergisuite.com

# PGAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3001

# Ngrok
NGROK_AUTHTOKEN=your_ngrok_authtoken
NGROK_DOMAIN=your-api-domain.ngrok-free.dev

# S3 / MinIO
AWS_REGION=us-east-1
# Browser-facing endpoint used inside presigned upload/view URLs.
# For external storage this can be the same URL as MINIO_ENDPOINT.
AWS_S3_PUBLIC_ENDPOINT=https://object-vault.sysanctum.dpdns.org
MINIO_NGROK_ENABLED=false
MINIO_NGROK_DOMAIN=
MINIO_NGROK_AUTHTOKEN=
S3_BUCKET_NAME=synergisuite-resources
CHATBOT_REPORTS_BUCKET=synergi-reports

# Meeting recordings
MINIO_ENDPOINT=https://object-vault.sysanctum.dpdns.org
MINIO_ACCESS_KEY=<your-new-access-key>
MINIO_SECRET_KEY=<your-new-secret-key>
MINIO_BUCKET=synergi-recordings
LIVEKIT_WEBHOOK_SECRET=
LIVEKIT_RECORDING_LAYOUT=speaker

# LiveKit voice calls
LIVEKIT_URL=wss://your-livekit-server-url
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
